# Copy to .env and fill with real secrets. Never commit .env or production env files.

# App runtime
APP_ENV=development
NODE_ENV=development
PORT=8080
GO_API_PORT=8090
PYTHON_WORKER_PORT=8091
TYPESCRIPT_API_URL="http://localhost:8080"
PYTHON_WORKER_URL="http://localhost:8091"

# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_HOURS=12
APP_URL="http://localhost:21950"
API_PUBLIC_URL="http://localhost:8080"
SUPPORT_EMAIL="contact@tallythis.xyz"
# Keep demos disabled in production. Use a separate development database for sample data.
ALLOW_DEMO_SEED=false

# OAuth login. Provider client secrets must stay server-side.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8080/api/auth/google/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8080/api/auth/github/callback"

# Cloudflare R2 private storage
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_URL=""
CLOUDFLARE_R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"

# Backward-compatible storage aliases used by older code paths
STORAGE_PROVIDER=r2
STORAGE_BUCKET=""
STORAGE_REGION=auto
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=""

# Claude (Anthropic) — fallback only, used when every Gemini model fails
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=16000
# Needed only for organisation-level keys that are not scoped to a workspace (Console → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=""

# Gemini — primary AI provider
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-2.5-flash
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=4096

# NVIDIA fallback provider
NVIDIA_API_KEY=""
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=""
NVIDIA_TEMPERATURE=0
NVIDIA_MAX_TOKENS=4096

# OpenRouter emergency fallback. Disabled by default.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=""
OPENROUTER_ENABLED=false
OPENROUTER_PRODUCTION_ONLY=true
OPENROUTER_DAILY_LIMIT_INR=""
OPENROUTER_MAX_REQUESTS_PER_DAY=25

# AI controls
AI_PROVIDER_ORDER=gemini,claude
AI_ENABLE_FALLBACKS=true
AI_ENABLE_STRUCTURED_OUTPUT=true
AI_ENABLE_LOGGING=true
AI_STORE_RAW_PROMPTS=false
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
