# Railway service name: gateway. Build context: repository root.
RAILWAY_DOCKERFILE_PATH=backend/gateway/Dockerfile
NODE_ENV=production
APP_ENV=production
PORT=8090
GO_API_PORT=8090
DATABASE_URL=
# The same value as on the api service: at least 32 random characters.
JWT_SECRET=
# The frontend origin, for example https://www.tallythis.xyz (comma-separated if several).
# In production no other site may call the gateway from a browser.
CORS_ORIGIN=
TYPESCRIPT_API_URL=http://api.railway.internal:8080
PYTHON_WORKER_URL=http://worker.railway.internal:8091
