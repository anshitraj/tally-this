# Railway service name: worker. Keep this service private.
RAILWAY_DOCKERFILE_PATH=backend/worker/Dockerfile
# The image sets APP_ENV=production, where the worker refuses every request except /health without this token.
# One random value, at least 24 characters, identical on the api service. Never on the gateway or the frontend.
WORKER_SERVICE_TOKEN=
PORT=8091
PYTHON_WORKER_PORT=8091
MAX_FILE_SIZE_MB=50
# Optional extraction provider; ordinary CSV/Excel/PDF parsing requires no key.
GEMINI_API_KEY=
GEMINI_MODEL=
