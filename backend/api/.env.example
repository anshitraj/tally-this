# Set these in the Railway api service. Do not commit a filled .env file.
RAILWAY_DOCKERFILE_PATH=backend/api/Dockerfile
NODE_ENV=production
APP_ENV=production
PORT=8080
DATABASE_URL=
JWT_SECRET=
SESSION_HOURS=12
APP_URL=
API_PUBLIC_URL=
CORS_ORIGIN=
SUPPORT_EMAIL=contact@tallythis.xyz
ALLOW_DEMO_SEED=false
PYTHON_WORKER_URL=http://worker.railway.internal:8091
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional explicit endpoint; leave public URL unset for private documents.
CLOUDFLARE_R2_ENDPOINT=
# Optional OAuth (callbacks use the frontend /api/auth/... proxy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# Optional AI. Rules and standard file parsers work without keys.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_ENABLED=false
