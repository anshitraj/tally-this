{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "esbuild src/services/jobAutomation.test.ts src/services/pdfStatement.test.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/tests --out-extension:.js=.mjs --log-level=warning && node --test dist/tests/jobAutomation.test.mjs dist/tests/pdfStatement.test.mjs",
    "read-statement": "esbuild scripts/read-statement.ts --bundle --platform=node --format=esm --external:pdf-parse --external:pdfkit --external:@anthropic-ai/sdk --external:zod --external:drizzle-orm --external:dotenv --external:pino --outfile=dist/tools/read-statement.mjs --log-level=warning && node dist/tools/read-statement.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@napi-rs/canvas": "^1.0.0",
    "@swc/helpers": "0.3.17",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
