# Settings that are NOT secret. Copy this file to runtime.env (it is git-ignored), fill it in, and deploy.sh puts it
# on the VM. Passwords, keys and tokens never go here: they live in Google Secret Manager (see set-secrets.sh).

# Where the backend is reached from, and where people sign in.
SITE_ADDRESS=api.tallythis.xyz
ACME_EMAIL=contact@tallythis.xyz
APP_ORIGIN=https://www.tallythis.xyz
SUPPORT_EMAIL=contact@tallythis.xyz

# Cloudflare R2, the private bucket that holds uploaded files. The access key and secret are in Secret Manager.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
STORAGE_FORCE_PATH_STYLE=true

# Neon sign-in: the public addresses shown in the Neon console under Auth.
NEON_AUTH_URL=
NEON_JWKS_URL=
# Leave this out until sign-in through Neon has been checked for everyone; false then closes the older password sign-in.
# LEGACY_PASSWORD_LOGIN=false

# AI. The keys are in Secret Manager; these only choose the models.
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-2.5-flash
AI_PROVIDER_ORDER=gemini,claude
# ANTHROPIC_MODEL=
# ANTHROPIC_WORKSPACE_ID=
# true only when the Gemini key belongs to a paid, billed Google project. Then Privacy mode may send a scan to Gemini.
PRIVACY_AI_ALLOWED=false

# Limits.
MAX_UPLOAD_MB=60
HISTORY_MONTHS=3
OCR_PAGES_IN_FLIGHT=3
